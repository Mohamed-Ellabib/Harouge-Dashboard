{
  "name": "labibtech-commerce-saas",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20 <24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "node ./scripts/run-workspace-tests.js",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "backend:configure": "npm.cmd run supabase:configure --workspace @dtc/backend --",
    "backend:rotate-password": "npm.cmd run supabase:rotate-password --workspace @dtc/backend",
    "backend:migrate": "npm.cmd run supabase:db:migrate --workspace @dtc/backend",
    "backend:harden": "npm.cmd run supabase:harden --workspace @dtc/backend",
    "backend:platform-admin": "npm.cmd run supabase:platform-admin --workspace @dtc/backend",
    "backend:demo-portfolio": "npm.cmd run supabase:demo-portfolio --workspace @dtc/backend",
    "backend:probe": "npm.cmd run supabase:probe --workspace @dtc/backend",
    "backend:status": "npm.cmd run supabase:status --workspace @dtc/backend",
    "backend:monitor": "npm.cmd run supabase:monitor --workspace @dtc/backend",
    "vendor:dev": "turbo dev --filter=@dtc/vendor-dashboard",
    "vendor:build": "turbo build --filter=@dtc/vendor-dashboard",
    "platform:dev": "turbo dev --filter=@dtc/platform-dashboard",
    "platform:build": "turbo build --filter=@dtc/platform-dashboard",
    "platform:typecheck": "npm run typecheck --workspace @dtc/platform-dashboard",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "storefront:build": "turbo build --filter=@dtc/storefront",
    "storefront:typecheck": "npm run typecheck --workspace @dtc/storefront",
    "storefront:test": "npm run test --workspace @dtc/storefront",
    "storefront:accept": "npm run accept:phase3a-storefront --workspace @dtc/backend",
    "commerce:accept": "npm run accept:phase3b-commerce --workspace @dtc/backend"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.16.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ]
}
