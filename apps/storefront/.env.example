# Public Store API key for this Store deployment. Never place its value in URLs or logs.
VITE_MEDUSA_PUBLISHABLE_KEY=

# Local development only. The production bundle ignores this Store selector.
VITE_STOREFRONT_DEV_HANDLE=

# Local Vite server proxy target. The non-VITE prefix keeps it out of browser configuration.
STOREFRONT_PROXY_TARGET=http://127.0.0.1:9000

# Local visual QA only. Demo data is unavailable in production builds.
VITE_STOREFRONT_VISUAL_PREVIEW=false
