{
  "name": "@dtc/backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "seed": "medusa exec ./src/migration-scripts/initial-data-seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node ./scripts/run-tests.js all",
    "test:integration:http": "node ./scripts/run-tests.js integration:http",
    "test:integration:modules": "node ./scripts/run-tests.js integration:modules",
    "test:unit": "node ./scripts/run-tests.js unit",
    "test:with-db": "node ./scripts/run-with-disposable-postgres.mjs node ./scripts/run-tests.js all",
    "test:commerce-readiness": "node ./scripts/run-with-disposable-postgres.mjs node ./scripts/run-tests.js integration:http phase2c-commerce-readiness.spec.ts",
    "accept:phase3a-storefront": "node ./scripts/run-with-disposable-postgres.mjs node ./scripts/run-phase3a-storefront-smoke.mjs",
    "accept:phase3b-commerce": "node ./scripts/run-with-disposable-postgres.mjs node ./scripts/run-phase3a-storefront-smoke.mjs --phase3b",
    "diagnose:product-channels": "medusa exec ./src/scripts/diagnose-product-sales-channels.ts -- --dry-run",
    "saas:backfill-stores": "medusa exec ./src/scripts/saas-backfill-stores.ts --",
    "saas:backfill-cart-order-store": "medusa exec ./src/scripts/saas-backfill-cart-order-store.ts --",
    "medusa:disposable": "node ./scripts/run-disposable-medusa.js"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.17.0",
    "@medusajs/admin-shared": "2.17.0",
    "@medusajs/caching": "2.17.0",
    "@medusajs/cli": "2.17.0",
    "@medusajs/dashboard": "2.17.0",
    "@medusajs/draft-order": "2.17.0",
    "@medusajs/framework": "2.17.0",
    "@medusajs/medusa": "2.17.0",
    "@medusajs/ui": "4.1.15",
    "@tanstack/react-query": "5.64.2",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.3",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "^2.16.0",
    "@medusajs/test-utils": "2.17.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "pg-god": "^1.0.12",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": "\u003e=20 \u003c24"
  },
  "packageManager": "npm@11.12.1"
}
